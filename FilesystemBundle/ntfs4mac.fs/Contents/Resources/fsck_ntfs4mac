#!/bin/sh
# fsck_ntfs4mac — verify/repair helper (Disk Utility First Aid, Disk
# Arbitration). Forwards to /sbin/fsck_fskit for the ntfs4mac module, whose
# check syntax is "nqyfl"; other fsck_* flags (e.g. -x XML output) are dropped.
set -u

# FSKit modules are enabled per user, but Disk Utility / storagekitd run this
# helper as root. macOS 26 honours SUDO_UID for that. macOS 15 rejects the
# request from root with EINVAL before it reaches the module, so there the
# FSKit tool is run as the console user instead (via launchctl asuser).
RUN_AS_UID=""
RUN_AS_USER=""
if [ "$(id -u)" = 0 ]; then
    console_uid=$(stat -f %u /dev/console 2>/dev/null || echo 0)
    if [ "$console_uid" != 0 ]; then
        os_major=$(sw_vers -productVersion 2>/dev/null | cut -d. -f1)
        if [ "${os_major:-0}" -lt 26 ]; then
            RUN_AS_UID=$console_uid
            RUN_AS_USER=$(id -un "$console_uid")
        elif [ -z "${SUDO_UID:-}" ]; then
            SUDO_UID=$console_uid
            SUDO_GID=$(id -g "$console_uid" 2>/dev/null || echo 20)
            export SUDO_UID SUDO_GID
        fi
    fi
fi
# Prefix that runs a command as the console user when required.
as_user() {
    if [ -n "$RUN_AS_UID" ]; then
        exec launchctl asuser "$RUN_AS_UID" sudo -u "$RUN_AS_USER" "$@"
    fi
    exec "$@"
}
flags=""
while getopts ":nqyflxdD:" opt; do
    case "$opt" in
        n|q|y|f|l) flags="$flags -$opt" ;;
        *) ;;
    esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || { echo "usage: fsck_ntfs4mac [-n|-q|-y] device" >&2; exit 8; }
for dev in "$@"; do :; done
case "$dev" in
    /dev/rdisk*) dev="/dev/${dev#/dev/r}" ;;
    disk*)       dev="/dev/$dev" ;;
esac
# shellcheck disable=SC2086
as_user /sbin/fsck_fskit -t ntfs4mac $flags "$dev"
