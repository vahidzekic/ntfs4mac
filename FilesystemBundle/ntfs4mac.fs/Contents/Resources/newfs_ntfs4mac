#!/bin/sh
# newfs_ntfs4mac — format helper for Disk Utility / `diskutil eraseVolume`.
# Translates newfs_* style arguments and forwards to the ntfs4mac FSKit module
# through /sbin/newfs_fskit. The module's format syntax is "L:v:c:p:QfC";
# other flags Disk Utility may pass are dropped so the strict module parser
# never rejects them.
set -u

# FSKit modules are enabled per user, but Disk Utility / storagekitd run this
# helper as root. macOS 26 honours SUDO_UID for that. macOS 15 rejects the
# request from root with EINVAL before it reaches the module, so there the
# FSKit tool is run as the console user instead (via launchctl asuser).
RUN_AS_UID=""
RUN_AS_USER=""
if [ "$(id -u)" = 0 ]; then
    console_uid=$(stat -f %u /dev/console 2>/dev/null || echo 0)
    if [ "$console_uid" != 0 ]; then
        os_major=$(sw_vers -productVersion 2>/dev/null | cut -d. -f1)
        if [ "${os_major:-0}" -lt 26 ]; then
            RUN_AS_UID=$console_uid
            RUN_AS_USER=$(id -un "$console_uid")
        elif [ -z "${SUDO_UID:-}" ]; then
            SUDO_UID=$console_uid
            SUDO_GID=$(id -g "$console_uid" 2>/dev/null || echo 20)
            export SUDO_UID SUDO_GID
        fi
    fi
fi
# Prefix that runs a command as the console user when required.
as_user() {
    if [ -n "$RUN_AS_UID" ]; then
        exec launchctl asuser "$RUN_AS_UID" sudo -u "$RUN_AS_USER" "$@"
    fi
    exec "$@"
}
args=""
add() { args="$args $(printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")")"; }

while getopts ":L:v:c:p:QfCN:F:S:s:R" opt; do
    case "$opt" in
        L|v) add -L; add "$OPTARG" ;;
        c)   add -c; add "$OPTARG" ;;
        p)   add -p; add "$OPTARG" ;;
        Q)   add -Q ;;
        f)   add -f ;;
        C)   add -C ;;
        *)   ;;  # unknown newfs_* flag: ignored
    esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || { echo "usage: newfs_ntfs4mac [-v label] [-c cluster] device" >&2; exit 64; }

# Use the last operand as the device; FSKit works on /dev/diskN, not rdisk.
for dev in "$@"; do :; done
case "$dev" in
    /dev/rdisk*) dev="/dev/${dev#/dev/r}" ;;
    disk*)       dev="/dev/$dev" ;;
esac

eval "as_user /sbin/newfs_fskit -t ntfs4mac $args \"\$dev\""
